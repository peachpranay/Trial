# 19. APPLY EMA TO THE 9 PARAMETERS
# ============================================================
#
# EMA is:
#
#     calculated independently for each ESN
#
#     sorted by engine cycle
#
#     span = 5
#
# ============================================================


EMA_SPAN = 5


print("\n========================================")
print("CALCULATING EMA")
print("========================================")


for feature in FEATURE_COLS:

    ema_col = (
        feature
        +
        "_EMA"
    )


    before[ema_col] = (

        before

        .groupby(
            ESN_COL
        )[feature]

        .transform(

            lambda x:

            x.ewm(
                span=EMA_SPAN,
                adjust=False,
                min_periods=1
            ).mean()

        )
    )


EMA_FEATURE_COLS = [

    feature + "_EMA"

    for feature in FEATURE_COLS

]


print(
    "EMA span:",
    EMA_SPAN
)


# ============================================================
# 20. REMOVE MISSING EMA VALUES
# ============================================================

before = before.dropna(
    subset=EMA_FEATURE_COLS
).copy()


# ============================================================
# 21. MAHALANOBIS ANALYSIS
# ============================================================
#
# For EVERY ESN:
#
# 20–60% normalized LIFE
#       ↓
# healthy EMA distribution
#       ↓
# healthy mean
# healthy covariance
#       ↓
# Mahalanobis score for entire pre-replacement trajectory
#
# ============================================================


HEALTHY_START = 20

HEALTHY_END = 60

MIN_HEALTHY_POINTS = 10


mahal_results = []

baseline_results = []

skipped_esns = []


for esn, esn_data in before.groupby(
    ESN_COL
):

    esn_data = esn_data.sort_values(
        CYCLE_COL
    ).copy()


    # --------------------------------------------------------
    # Healthy region
    # --------------------------------------------------------

    healthy = esn_data[

        (
            esn_data[
                "Normalized_Life"
            ]
            >= HEALTHY_START
        )

        &

        (
            esn_data[
                "Normalized_Life"
            ]
            <= HEALTHY_END
        )

    ].copy()


    # --------------------------------------------------------
    # Minimum healthy points
    # --------------------------------------------------------

    if len(healthy) < MIN_HEALTHY_POINTS:

        skipped_esns.append({

            ESN_COL:
                esn,

            "Healthy_Count":
                len(healthy)

        })

        continue


    # --------------------------------------------------------
    # Healthy matrix
    # --------------------------------------------------------

    X_healthy = (

        healthy[
            EMA_FEATURE_COLS
        ]

        .astype(float)

        .values
    )


    # Entire trajectory

    X_all = (

        esn_data[
            EMA_FEATURE_COLS
        ]

        .astype(float)

        .values
    )


    # --------------------------------------------------------
    # Standardization
    # --------------------------------------------------------
    #
    # Fit ONLY on healthy data.
    #
    # --------------------------------------------------------

    scaler = StandardScaler()


    X_healthy_scaled = (

        scaler
        .fit_transform(
            X_healthy
        )
    )


    X_all_scaled = (

        scaler
        .transform(
            X_all
        )
    )


    # --------------------------------------------------------
    # Healthy covariance
    # --------------------------------------------------------

    covariance_model = (

        EmpiricalCovariance(
            assume_centered=False
        )
    )


    covariance_model.fit(
        X_healthy_scaled
    )


    # --------------------------------------------------------
    # Mahalanobis
    # --------------------------------------------------------

    mahal_squared = (

        covariance_model
        .mahalanobis(
            X_all_scaled
        )
    )


    mahal_distance = np.sqrt(

        np.maximum(
            mahal_squared,
            0
        )

    )


    esn_data[
        "Mahalanobis_Distance"
    ] = mahal_distance


    # --------------------------------------------------------
    # Store healthy baseline
    # --------------------------------------------------------

    baseline_row = {

        ESN_COL:
            esn,

        "Healthy_Count":
            len(healthy),

        "Healthy_Start_Cycle":
            healthy[CYCLE_COL].min(),

        "Healthy_End_Cycle":
            healthy[CYCLE_COL].max()
    }


    for i, feature in enumerate(
        FEATURE_COLS
    ):

        baseline_row[
            feature
            +
            "_Healthy_Mean"
        ] = scaler.mean_[i]


        baseline_row[
            feature
            +
            "_Healthy_STD"
        ] = scaler.scale_[i]


    baseline_results.append(
        baseline_row
    )


    mahal_results.append(
        esn_data
    )


# ============================================================
# 22. COMBINE MAHALANOBIS RESULTS
# ============================================================

if len(mahal_results) == 0:

    raise ValueError(
        "No ESNs were successfully processed."
    )


result_df = pd.concat(
    mahal_results,
    ignore_index=True
)


baseline_df = pd.DataFrame(
    baseline_results
)


print("\n========================================")
print("MAHALANOBIS COMPLETE")
print("========================================")

print(
    "ESNs processed:",
