# ============================================================
# 17. CYCLE-BASED LIFE NORMALIZATION
# ============================================================
#
# VERY IMPORTANT:
#
# We do NOT use DATETIME here.
#
# For every ESN:
#
# first pre-replacement cycle = 0%
#
# last pre-replacement cycle = 100%
#
# Example:
#
# Cycle 1000 -> 0%
# Cycle 1100 -> 25%
# Cycle 1200 -> 50%
# Cycle 1300 -> 75%
# Cycle 1400 -> 100%
#
# If the aircraft doesn't fly for 10 days between 1100
# and 1200, that has NO effect on life percentage.
#
# ============================================================


def normalize_cycles(group):

    group = group.sort_values(
        CYCLE_COL
    ).copy()


    first_cycle = group[
        CYCLE_COL
    ].min()


    last_cycle = group[
        CYCLE_COL
    ].max()


    if last_cycle == first_cycle:

        group[
            "Normalized_Life"
        ] = 0.0

    else:

        group[
            "Normalized_Life"
        ] = (

            (
                group[
                    CYCLE_COL
                ]
                -
                first_cycle
            )

            /

            (
                last_cycle
                -
                first_cycle
            )

            * 100
        )


    return group


before = (

    before

    .groupby(
        ESN_COL,
        group_keys=False
    )

    .apply(
        normalize_cycles
    )

    .reset_index(
        drop=True
    )
)


