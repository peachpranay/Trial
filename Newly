# ============================================================
# 23. HEALTHY MAHALANOBIS PERCENTILES
# ============================================================
#
# Calculate for EACH ESN separately:
#
# P50
# P70
# P80
# P90
# P95
#
# using only healthy 20–60% observations.
#
# ============================================================


PERCENTILES = [
    50,
    70,
    80,
    90,
    95
]


threshold_results = []

step_results = []


for esn, esn_data in result_df.groupby(
    ESN_COL
):

    esn_data = esn_data.sort_values(
        CYCLE_COL
    ).copy()


    healthy_scores = esn_data[

        (
            esn_data[
                "Normalized_Life"
            ]
            >= HEALTHY_START
        )

        &

        (
            esn_data[
                "Normalized_Life"
            ]
            <= HEALTHY_END
        )

    ][
        "Mahalanobis_Distance"
    ].dropna()


    if len(healthy_scores) < MIN_HEALTHY_POINTS:

        continue


    # --------------------------------------------------------
    # Percentiles
    # --------------------------------------------------------

    thresholds = {

        f"P{p}":

        np.percentile(
            healthy_scores,
            p
        )

        for p in PERCENTILES
    }


    threshold_row = {

        ESN_COL:
            esn,

        "Healthy_Count":
            len(healthy_scores)

    }


    threshold_row.update(
        thresholds
    )


    threshold_results.append(
        threshold_row
    )


    # ========================================================
    # 24. STEP FUNCTION
    # ========================================================
    #
    # Bin 1:
    #       < P50
    #
    # Bin 2:
    #       P50–P70
    #
    # Bin 3:
    #       P70–P80
    #
    # Bin 4:
    #       P80–P90
    #
    # Bin 5:
    #       P90–P95
    #
    # Bin 6:
    #       > P95
    #
    # ========================================================


    bin_edges = [

        thresholds["P50"],

        thresholds["P70"],

        thresholds["P80"],

        thresholds["P90"],

        thresholds["P95"]

    ]


    esn_data[
        "Degradation_Bin"
    ] = (

        np.digitize(

            esn_data[
                "Mahalanobis_Distance"
            ],

            bins=bin_edges,

            right=False

        )

        + 1

    )


    # --------------------------------------------------------
    # Human-readable labels
    # --------------------------------------------------------

    state_map = {

        1: "Healthy",

        2: "Low deviation",

        3: "Moderate deviation",

        4: "Elevated deviation",

        5: "High deviation",

        6: "Very high deviation"

    }


    esn_data[
        "Degradation_State"
    ] = (

        esn_data[
            "Degradation_Bin"
        ]

        .map(
            state_map
        )

    )


    step_results.append(
        esn_data
    )


# ============================================================
# 25. COMBINE STEP RESULTS
# ============================================================

step_function_df = pd.concat(
    step_results,
    ignore_index=True
)


threshold_df = pd.DataFrame(
    threshold_results
)


print("\n========================================")
print("STEP FUNCTION COMPLETE")
print("========================================")


print(
    "ESNs:",
    step_function_df[
        ESN_COL
    ].nunique()
)


# ============================================================
# 26. PERSISTENCE ANALYSIS
# ============================================================
#
# A single point above P95 may be noise.
#
# We therefore check whether P95 is crossed for
# 3 consecutive takeoff observations.
#
# ============================================================


PERSISTENCE_LENGTH = 3


persistence_results = []


for esn, esn_data in step_function_df.groupby(
    ESN_COL
):

    esn_data = esn_data.sort_values(
        CYCLE_COL
    ).copy()


    threshold_row = threshold_df[
        threshold_df[ESN_COL] == esn
    ].iloc[0]


    p95 = threshold_row[
        "P95"
    ]


    # --------------------------------------------------------
    # P95 crossing
    # --------------------------------------------------------

    esn_data[
        "P95_Crossed"
    ] = (

        esn_data[
            "Mahalanobis_Distance"
        ]

        >= p95

    )


    # --------------------------------------------------------
    # Persistent P95
    # --------------------------------------------------------

    esn_data[
        "P95_Persistent"
    ] = (

        esn_data[
            "P95_Crossed"
        ]

        .rolling(
            window=PERSISTENCE_LENGTH,
            min_periods=PERSISTENCE_LENGTH
        )

        .sum()

        >= PERSISTENCE_LENGTH

    )


    # --------------------------------------------------------
    # Bin changes
    # --------------------------------------------------------

    esn_data[
        "Bin_Changed"
    ] = (

        esn_data[
            "Degradation_Bin"
        ]

        !=

        esn_data[
            "Degradation_Bin"
        ].shift(1)

    )


    # --------------------------------------------------------
    # Bin groups
    # --------------------------------------------------------

    esn_data[
        "Bin_Group"
    ] = (

        esn_data[
            "Bin_Changed"
        ]

        .cumsum()

    )


    # --------------------------------------------------------
    # Consecutive observations in current bin
    # --------------------------------------------------------

    esn_data[
        "Consecutive_Bin_Count"
    ] = (

        esn_data

        .groupby(
            "Bin_Group"
        )

        .cumcount()

        + 1

    )


    persistence_results.append(
        esn_data
    )


# ============================================================
# 27. FINAL DATASET
# ============================================================

step_function_df = pd.concat(
    persistence_results,
    ignore_index=True
)


# ============================================================
# 28. CREATE ESN SUMMARY
# ============================================================


summary_results = []


for esn, esn_data in step_function_df.groupby(
    ESN_COL
):

    esn_data = esn_data.sort_values(
        CYCLE_COL
    ).copy()


    threshold_row = threshold_df[
        threshold_df[ESN_COL] == esn
    ].iloc[0]


    p95 = threshold_row[
        "P95"
    ]


    # --------------------------------------------------------
    # Maximum degradation bin
    # --------------------------------------------------------

    max_bin = int(
        esn_data[
            "Degradation_Bin"
        ].max()
    )


    # --------------------------------------------------------
    # Last score
    # --------------------------------------------------------

    last_score = (

        esn_data[
            "Mahalanobis_Distance"
        ].iloc[-1]

    )


    # --------------------------------------------------------
    # Maximum score
    # --------------------------------------------------------

    max_score = (

        esn_data[
            "Mahalanobis_Distance"
        ].max()

    )


    # --------------------------------------------------------
    # First P95 crossing
    # --------------------------------------------------------

    p95_crossed = esn_data[

        esn_data[
            "Mahalanobis_Distance"
        ]
        >=
        p95

    ]


    if len(p95_crossed) > 0:

        first_p95_life = (

            p95_crossed[
                "Normalized_Life"
            ].iloc[0]

        )

        first_p95_cycle = (

            p95_crossed[
                CYCLE_COL
            ].iloc[0]

        )

    else:

        first_p95_life = np.nan

        first_p95_cycle = np.nan


    # --------------------------------------------------------
    # Persistent P95
    # --------------------------------------------------------

    persistent = esn_data[
        esn_data[
            "P95_Persistent"
        ]
    ]


    if len(persistent) > 0:

        first_persistent_life = (

            persistent[
                "Normalized_Life"
            ].iloc[0]

        )

        first_persistent_cycle = (

            persistent[
                CYCLE_COL
            ].iloc[0]

        )

    else:

        first_persistent_life = np.nan

        first_persistent_cycle = np.nan


    # --------------------------------------------------------
    # Life remaining
    # --------------------------------------------------------

    if pd.notna(
        first_p95_life
    ):

        life_remaining_p95 = (
            100
            -
            first_p95_life
        )

    else:

        life_remaining_p95 = np.nan


    if pd.notna(
        first_persistent_life
    ):

        life_remaining_persistent = (
            100
            -
            first_persistent_life
        )

    else:

        life_remaining_persistent = np.nan


    # --------------------------------------------------------
    # Maximum persistence
    # --------------------------------------------------------

    max_persistence = (

        esn_data[
            "Consecutive_Bin_Count"
        ].max()

    )


    summary_results.append({

        ESN_COL:
            esn,

        "First_Cycle":
            esn_data[
                CYCLE_COL
            ].min(),

        "Last_Cycle":
            esn_data[
                CYCLE_COL
            ].max(),

        "Max_Degradation_Bin":
            max_bin,

        "Last_Mahalanobis":
            last_score,

        "Max_Mahalanobis":
            max_score,

        "First_P95_Cycle":
            first_p95_cycle,

        "First_P95_Life":
            first_p95_life,

        "Life_Remaining_At_P95":
            life_remaining_p95,

        "First_Persistent_P95_Cycle":
            first_persistent_cycle,

        "First_Persistent_P95_Life":
            first_persistent_life,

        "Life_Remaining_At_Persistent_P95":
            life_remaining_persistent,

        "Max_Consecutive_Bin_Count":
            max_persistence

    })


