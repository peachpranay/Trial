import importlib
import pytest
import rraid


@pytest.mark.parametrize(
    "name",
    [
        "RRAidTarget",
        "build_converter_configs",
        "build_scorer",
        "run_scan",
        "calculate_cost",
        "estimate_all_strategies",
        "print_cost_comparison",
        "build_llm_configs",
        "profile_token_usage",
        "load_model_pricing",
        "LLMPricingConfig",
    ],
)
def test_lazy_exports(name, monkeypatch):

    class FakeModule:
        pass

    fake_module = FakeModule()

    # Make every requested attribute exist on the fake module
    for attr in [
        "RRAidTarget",
        "build_converter_configs",
        "build_scorer",
        "run_scan",
        "calculate_cost",
        "estimate_all_strategies",
        "print_cost_comparison",
        "build_llm_configs",
        "profile_token_usage",
        "load_model_pricing",
        "LLMPricingConfig",
    ]:
        setattr(fake_module, attr, object())

    def fake_import_module(module_path):
        return fake_module

    monkeypatch.setattr(
        importlib,
        "import_module",
        fake_import_module
    )

    result = getattr(rraid, name)

    assert result is not None


def test_unknown_attribute():
    with pytest.raises(AttributeError):
        getattr(rraid, "does_not_exist")
