def test_report_to_dict_keys():
    report = generate_report([], "test")

    d = report_to_dict(report)

    assert set(d.keys()) == {
        "project_name",
        "total_attacks",
        "vulnerabilities_found",
        "pass_rate",
        "results",
    }


def test_report_to_dict_result_keys():
    results = [
        ScanResult(
            "obj",
            "raw",
            "resp",
            False,
            "rationale",
        )
    ]

    report = generate_report(results, "test")
    d = report_to_dict(report)

    result_keys = set(d["results"][0].keys())

    assert result_keys == {
        "objective",
        "converter",
        "response",
        "vulnerable",
        "rationale",
    }


def test_report_to_dict_truncates_long_response():
    long_resp = "x" * 1000

    results = [
        ScanResult(
            "q",
            "raw",
            long_resp,
            False,
        )
    ]

    report = generate_report(results, "test")
    d = report_to_dict(report)

    assert len(d["results"][0]["response"]) <= 500


def test_report_to_dict_short_response_not_truncated():
    short_resp = "short"

    results = [
        ScanResult(
            "q",
            "raw",
            short_resp,
            False,
        )
    ]

    report = generate_report(results, "test")
    d = report_to_dict(report)

    assert d["results"][0]["response"] == short_resp


def test_report_to_dict_vulnerable_flag_correct():
    results = [
        ScanResult(
            "q1",
            "raw",
            "safe",
            False,
        ),
        ScanResult(
            "q2",
            "raw",
            "vulnerable",
            True,
        ),
    ]

    report = generate_report(results, "test")
    d = report_to_dict(report)

    assert d["results"][0]["vulnerable"] is False
    assert d["results"][1]["vulnerable"] is True


def test_report_to_dict_preserves_rationale():
    result = ScanResult(
        "q",
        "raw",
        "response",
        True,
        "Sensitive information exposed.",
    )

    report = generate_report([result], "test")
    d = report_to_dict(report)

    assert (
        d["results"][0]["rationale"]
        == "Sensitive information exposed."
    )


def test_report_to_dict_preserves_report_values():
    results = [
        ScanResult(
            "q",
            "raw",
            "response",
            True,
            "reason",
        )
    ]

    report = generate_report(results, "my-project")
    d = report_to_dict(report)

    assert d["project_name"] == "my-project"
    assert d["total_attacks"] == 1
    assert d["vulnerabilities_found"] == 1
    assert d["pass_rate"] == 0.0
