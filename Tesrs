import pytest
from unittest.mock import MagicMock, patch

import rraid


@pytest.mark.parametrize(
    "name",
    [
        "RRAidTarget",
        "build_converter_configs",
        "build_scorer",
        "run_scan",
        "calculate_cost",
        "estimate_all_strategies",
        "print_cost_comparison",
        "build_llm_configs",
        "profile_token_usage",
        "load_model_pricing",
        "LLMPricingConfig",
    ],
)
def test_lazy_exports(name):
    mock_module = MagicMock()

    # Whatever attribute __getattr__ asks for should exist
    mock_module.__getattr__ = lambda attr: MagicMock()

    with patch("importlib.import_module", return_value=mock_module) as mock_import:
        result = getattr(rraid, name)

        assert result is not None
        mock_import.assert_called_once()


def test_unknown_attribute():
    with pytest.raises(AttributeError):
        getattr(rraid, "does_not_exist")
