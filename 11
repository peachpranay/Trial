)


ax.axvline(

    p90_ratio,

    linestyle=":",

    linewidth=2,

    label=(

        f"90th percentile = "
        f"{p90_ratio:.2f}x"

    )

)


# 95th percentile

p95_ratio = ratios.quantile(
    0.95
)


ax.axvline(

    p95_ratio,

    linestyle="-.",

    linewidth=2,

    label=(

        f"95th percentile = "
        f"{p95_ratio:.2f}x"

    )

)


ax.set_xlabel(
    "Full-life P95 / Healthy P95"
)


ax.set_ylabel(
    "Number of ESNs"
)


ax.set_title(

    "Distribution of P95 Multipliers Across ESNs",

    fontweight="bold"

)


ax.grid(
    True,
    alpha=0.20
)


ax.legend()


plt.tight_layout()


plt.show()


