    )

)


no_previous_shop_esns = (

    max_run_per_esn[

        max_run_per_esn[
            "max_run"
        ] == 1

    ]["ESN"]

    .tolist()

)


print("\n")
print("=" * 70)
print("NO-PREVIOUS-SHOP FILTER")
print("=" * 70)

print(
    f"ESNs before Run_Number filter : "
    f"{before_replacement['ESN'].nunique():,}"
)

print(
    f"ESNs with max(Run_Number) == 1 : "
    f"{len(no_previous_shop_esns):,}"
)


# ============================================================
# 17. APPLY RUN_NUMBER FILTER
# ============================================================
#
# We apply the same valid ESN list to both datasets.
#
# BUT:
