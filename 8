# ============================================================
# 34. ESN PLOT FUNCTION
# ============================================================

def create_esn_plot(
    esn,
    data,
    summary,
    output_directory
):


    plot_data = (

        data[
            data[
                "ESN"
            ] == esn
        ]

        .copy()

        .sort_values(
            "LIFE_PERCENT"
        )

    )


    # Only show 20-100% life

    plot_data = plot_data[
        plot_data[
            "LIFE_PERCENT"
        ]
        >= PLOT_START_LIFE
    ].copy()


    if plot_data.empty:

        return None


    # --------------------------------------------------------
    # Summary row
    # --------------------------------------------------------

    row = (

        summary[
            summary[
                "ESN"
            ] == esn
        ]

        .iloc[0]

    )


    threshold = row[
        "95th_Percentile"
    ]


    detection_life = row[
        "Detection_Life_%"
    ]


    # --------------------------------------------------------
    # Create figure
    # --------------------------------------------------------

    fig, ax = plt.subplots(

        figsize=(13, 6.5)

    )


    # ========================================================
    # HEALTHY BASELINE REGION
    # ========================================================

    ax.axvspan(

        BASELINE_START,

        BASELINE_END,

        alpha=0.10,

        label="Healthy baseline (20–60%)"

    )


    # ========================================================
    # RAW MAHALANOBIS
    # ========================================================
    #
    # Faint because raw point-to-point variation is not the
    # primary degradation signal.
    # ========================================================

    ax.plot(

        plot_data[
            "LIFE_PERCENT"
        ],

        plot_data[
            "MAHALANOBIS_SCORE"
        ],

        linewidth=1.0,

        alpha=0.25,

        label="Raw Mahalanobis"

    )


    # ========================================================
    # CLEAN ROLLING SCORE
    # ========================================================

    ax.plot(

        plot_data[
            "LIFE_PERCENT"
        ],

        plot_data[
            "ROLLING_SCORE_CLEAN"
        ],

        linewidth=2.8,

        label="Rolling Mahalanobis (5)"

    )


    # ========================================================
    # 95TH PERCENTILE
    # ========================================================

    ax.axhline(

        threshold,

        linestyle="--",

        linewidth=2,

        label=(
            f"95th percentile = "
            f"{threshold:.2f}"
        )

    )


    # ========================================================
    # SUSTAINED DETECTION
    # ========================================================

    sustained = plot_data[
        plot_data[
            "SUSTAINED_DEGRADATION"
        ]
    ]


    if not sustained.empty:

        detection_start = (

            sustained[
                "LIFE_PERCENT"
            ]

            .min()

        )


        ax.axvline(

            detection_start,

            linestyle=":",

            linewidth=2,

            label=(
                f"Sustained deviation "
                f"≈ {detection_start:.1f}% life"
            )

        )


        # Shade only the detected region

        ax.axvspan(

            detection_start,

            100,

            alpha=0.05

        )


    # ========================================================
    # AXES
    # ========================================================

    ax.set_xlim(

        PLOT_START_LIFE,

        100

    )


    ax.set_xlabel(
        "Engine life (%)"
    )


    ax.set_ylabel(
        "Mahalanobis distance"
    )


    ax.set_title(

        f"Breather Degradation Trajectory — "
        f"ESN {int(esn)}",

        fontweight="bold",

        pad=15

    )


    ax.grid(
        True,
        alpha=0.20
    )


    # ========================================================
    # INFORMATION BOX
    # ========================================================

    if pd.isna(
        detection_life
    ):

        detection_text = (
            "No sustained threshold crossing"
        )

    else:

        detection_text = (
            f"Sustained crossing: "
            f"{detection_life:.1f}% life"
        )


    info_text = (

        f"Healthy mean: "
        f"{row['Healthy_Mean']:.2f}\n"

        f"95th percentile: "
        f"{row['95th_Percentile']:.2f}\n"

        f"{detection_text}"

    )


    ax.text(

        0.98,

        0.97,

        info_text,

        transform=ax.transAxes,

        ha="right",

        va="top",

        fontsize=10,

        bbox=dict(

            boxstyle="round,pad=0.4",

            alpha=0.12

        )

    )


    ax.legend(
        loc="upper left"
    )


    plt.tight_layout()


    # ========================================================
    # SAVE
    # ========================================================

    output_path = os.path.join(

        output_directory,

        f"ESN_{int(esn)}_Mahalanobis_Demo.png"

    )


    plt.savefig(

        output_path,

        bbox_inches="tight"

    )


    plt.show()

    plt.close()


    return output_path


