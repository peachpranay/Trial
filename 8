            ).mean()

        )

    )

    ema_columns.append(
        ema_col
    )


print(
    "EMA calculation complete."
)


# ============================================================
# 20. NORMALIZE LIFE
# ============================================================

def normalize_life_score(data):

    data = (

        data

        .sort_values(
            [
                "ESN",
                "DATETIME"
            ]
        )

        .copy()

    )


    # Sequential row number for every ESN

    data["ROW_NUM"] = (

        data

        .groupby("ESN")

        .cumcount()

    )


    # Maximum row number for each ESN

    max_row = (

        data

        .groupby("ESN")[
            "ROW_NUM"
        ]

        .transform("max")

    )


    max_row = max_row.replace(
        0,
        np.nan
    )


    # Normalize 0-100%

    data["LIFE_PERCENT"] = (

        data["ROW_NUM"]

        /

        max_row

        *

        100

    )


    data["LIFE_PERCENT"] = (

        data["LIFE_PERCENT"]

        .fillna(0)

    )


    return data


before_replacement = (
    normalize_life_score(
        before_replacement
    )
)


# ============================================================
# 21. MAHALANOBIS FUNCTION
# ============================================================

def compute_mahalanobis_scores(
    data,
    baseline_mask,
    feature_columns
):

    # --------------------------------------------------------
    # Healthy baseline only
    # --------------------------------------------------------

    baseline = (

        data.loc[
            baseline_mask,
            feature_columns
        ]

        .dropna()

    )


    if len(baseline) < 10:

        raise ValueError(
            "Not enough healthy baseline "
            "observations."
        )


    X_baseline = (
        baseline
        .values
        .astype(float)
    )


    # --------------------------------------------------------
    # Healthy mean
    # --------------------------------------------------------

    mean_base = np.mean(
        X_baseline,
        axis=0
    )


    # --------------------------------------------------------
    # Healthy covariance
    # --------------------------------------------------------

    cov_base = np.cov(
        X_baseline,
        rowvar=False
    )


    cov_base = np.atleast_2d(
        cov_base
    )


    # --------------------------------------------------------
    # Numerical stabilization
    # --------------------------------------------------------

    cov_base = (

        cov_base

        +

        np.eye(
            cov_base.shape[0]
        )

        *

        1e-8

    )


    # Pseudo-inverse
    cov_inv = np.linalg.pinv(
        cov_base
    )


    # --------------------------------------------------------
    # Calculate Mahalanobis distance
    # --------------------------------------------------------

    scores = []


    for _, row in data.iterrows():

        x = (

            row[
                feature_columns
            ]

            .values

            .astype(float)

        )


        if np.isnan(x).any():

            scores.append(
                np.nan
            )

            continue


        difference = (
            x - mean_base
        )


        score = np.sqrt(

            difference.T

            @

            cov_inv

            @

            difference

        )


        scores.append(
            score
        )


    return np.array(
        scores
    )


# ============================================================
# 22. PROCESS EACH ESN INDEPENDENTLY
# ============================================================

print("\n")
print("=" * 70)
print("MAHALANOBIS ANALYSIS")
print("=" * 70)


all_results = []

summary_results = []


analysis_esns = (

    before_replacement[
        "ESN"
    ]

    .dropna()

    .unique()

)


print(
    f"ESNs entering Mahalanobis analysis: "
    f"{len(analysis_esns):,}"
)


# ============================================================
# 23. ESN LOOP
# ============================================================

for esn in analysis_esns:


    # --------------------------------------------------------
    # Get this ESN only
    # --------------------------------------------------------

    df_esn = (

        before_replacement[

            before_replacement[
                "ESN"
            ] == esn

        ]

        .copy()

        .sort_values(
            "DATETIME"
        )

        .reset_index(
            drop=True
        )

    )


    # Need enough observations

    if len(df_esn) < 20:

        continue


    # --------------------------------------------------------
    # HEALTHY BASELINE
    # 20-60% LIFE
    # --------------------------------------------------------

    baseline_mask = (

        (

            df_esn[
                "LIFE_PERCENT"
            ]

            >=

            BASELINE_START

        )

        &

        (

            df_esn[
                "LIFE_PERCENT"
            ]

            <=

            BASELINE_END

        )

    )


    baseline_count = (
        baseline_mask.sum()
    )


    if baseline_count < 10:

        continue


    # --------------------------------------------------------
    # MAHALANOBIS
    # --------------------------------------------------------

    df_esn[
        "MAHALANOBIS_SCORE"
    ] = (

        compute_mahalanobis_scores(

            df_esn,

            baseline_mask,

            ema_columns

        )

    )


    # --------------------------------------------------------
    # ROLLING MAHALANOBIS
    # --------------------------------------------------------

    df_esn[
        "ROLLING_SCORE"
    ] = (

        df_esn[
            "MAHALANOBIS_SCORE"
        ]

        .rolling(

            window=ROLLING_WINDOW,

            min_periods=1

        )

        .mean()

    )


    # ========================================================
    # ISOLATED SPIKE FILTER
    # ========================================================
    #
    # This is used to reduce isolated sensor fluctuations.
    #
    # A point is considered a spike if:
    #
    # score >
    # rolling mean + 5 × rolling std
    #
    # It is NOT automatically treated as degradation.
    # ========================================================

    local_mean = (

        df_esn[
            "MAHALANOBIS_SCORE"
        ]

        .rolling(

            window=ROLLING_WINDOW,

            min_periods=1

        )

        .mean()

    )


    local_std = (

        df_esn[
            "MAHALANOBIS_SCORE"
        ]

        .rolling(

            window=ROLLING_WINDOW,

            min_periods=1

        )

        .std()

        .fillna(0)

    )


    spike_limit = (

        local_mean

        +

        SPIKE_THRESHOLD

        *

        local_std

    )


    df_esn[
        "IS_SPIKE"
    ] = (

        df_esn[
            "MAHALANOBIS_SCORE"
        ]

        >

        spike_limit

    )


    # --------------------------------------------------------
    # CLEAN MAHALANOBIS
    # --------------------------------------------------------

    df_esn[
        "MAHALANOBIS_SCORE_CLEAN"
    ] = (

        df_esn[
            "MAHALANOBIS_SCORE"
        ]

        .where(
            ~df_esn[
                "IS_SPIKE"
            ]
        )

    )


    # --------------------------------------------------------
    # CLEAN ROLLING SCORE
    # --------------------------------------------------------

    df_esn[
        "ROLLING_SCORE_CLEAN"
    ] = (

        df_esn[
            "MAHALANOBIS_SCORE_CLEAN"
        ]

        .rolling(

            window=ROLLING_WINDOW,

            min_periods=1

        )

        .mean()

    )


    # ========================================================
    # HEALTHY 95TH PERCENTILE
    # ========================================================
    #
    # IMPORTANT:
    #
    # The threshold is calculated from the healthy 20-60%
    # baseline.
    #
    # We do NOT calculate it from the entire life because
    # late-life degradation could inflate the threshold.
    # ========================================================

    healthy_rolling = (

        df_esn.loc[
            baseline_mask,
            "ROLLING_SCORE_CLEAN"
        ]

        .dropna()

    )


    if len(healthy_rolling) < 10:

        continue


    percentile_95 = np.percentile(

        healthy_rolling,

        PERCENTILE

    )


    df_esn[
        "PERCENTILE_95"
    ] = percentile_95


    # ========================================================
    # ABOVE THRESHOLD
    # ========================================================

    df_esn[
        "ABOVE_THRESHOLD"
    ] = (

        df_esn[
            "ROLLING_SCORE_CLEAN"
        ]

        >

        percentile_95

    )


    # ========================================================
    # ONLY LOOK AT LATE LIFE
    # ========================================================

    late_life_mask = (

        df_esn[
            "LIFE_PERCENT"
        ]

        >=

        PLOT_START_LIFE

    )


    above_late = (

        df_esn[
            "ABOVE_THRESHOLD"
        ]

        &

        late_life_mask

    )


    # ========================================================
    # SUSTAINED THRESHOLD CROSSING
    # ========================================================
    #
    # One large spike does NOT count.
    #
    # We require 5 consecutive observations above threshold.
    # ========================================================

    sustained_count = (

        above_late

        .astype(int)

        .rolling(
            window=SUSTAINED_POINTS
        )

        .sum()

    )


    df_esn[
        "SUSTAINED_DEGRADATION"
    ] = (

        sustained_count
        >=
        SUSTAINED_POINTS

    )


    # --------------------------------------------------------
    # Detection point
    # --------------------------------------------------------

    detection_rows = df_esn[
        df_esn[
            "SUSTAINED_DEGRADATION"
        ]
    ]


    if not detection_rows.empty:

        detection_life = (

            detection_rows[
                "LIFE_PERCENT"
            ]

            .iloc[0]

        )

    else:

        detection_life = np.nan


    # ========================================================
    # LATE LIFE STATISTICS
    # ========================================================

    late_data = df_esn[
        df_esn[
            "LIFE_PERCENT"
        ]
        >= 80
    ]


    if not late_data.empty:

        late_mean = (

            late_data[
                "ROLLING_SCORE_CLEAN"
            ]

            .mean()

        )


        late_median = (

            late_data[
                "ROLLING_SCORE_CLEAN"
            ]

            .median()

        )

    else:

        late_mean = np.nan

        late_median = np.nan


    # ========================================================
    # HEALTHY BASELINE STATISTICS
    # ========================================================

    healthy_mean = (
        healthy_rolling.mean()
    )


    healthy_median = (
        healthy_rolling.median()
    )


    # ========================================================
    # LATE / HEALTHY RATIO
    # ========================================================

    if (

        not pd.isna(
            healthy_mean
        )

        and

        healthy_mean > 0

    ):

        late_to_healthy_ratio = (

            late_mean

            /

            healthy_mean

        )

    else:

        late_to_healthy_ratio = np.nan


    # ========================================================
    # MAX SCORE
    # Stored for information ONLY.
    #
    # It will NOT be used to select demo ESNs.
    # ========================================================

    maximum_score = (

        df_esn[
            "MAHALANOBIS_SCORE"
        ]

        .max()

    )


    maximum_clean_score = (

        df_esn[
            "ROLLING_SCORE_CLEAN"
        ]

        .max()

    )


    # ========================================================
    # REPLACEMENT DATE
    # ========================================================

    replacement_date = (

        df_esn[
            REPLACEMENT_DATE_COLUMN
        ]

        .iloc[0]

    )


    # ========================================================
    # SUMMARY ROW
    # ========================================================

    summary_results.append({

        "ESN":
            int(esn),

        "Observations":
            len(df_esn),

        "Baseline_Observations":
            baseline_count,

        "Healthy_Mean":
            healthy_mean,

        "Healthy_Median":
            healthy_median,

        "95th_Percentile":
            percentile_95,

        "Detection_Life_%":
            detection_life,

        "Late_Life_Mean":
            late_mean,

        "Late_Life_Median":
            late_median,

        "Late_to_Healthy_Ratio":
            late_to_healthy_ratio,

        "Maximum_Raw_Mahalanobis":
            maximum_score,

        "Maximum_Clean_Rolling":
            maximum_clean_score,

        "Sustained_Detection":
            not detection_rows.empty,

        "Replacement_Date":
            replacement_date

    })


    # Store complete ESN result

    all_results.append(
        df_esn
    )


# ============================================================
# 24. COMBINE ALL ESN RESULTS
# ============================================================

if not all_results:

    raise ValueError(
        "No ESNs were successfully processed."
    )


anomaly_results = pd.concat(

    all_results,

