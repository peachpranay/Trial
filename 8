    )
].copy()


print(
    f"\nBEFORE rows after Run_Number filter : "
    f"{len(before_replacement):,}"
)

print(
    f"AFTER rows after Run_Number filter : "
    f"{len(after_replacement):,}"
)


# ============================================================
# 18. SORT BEFORE-REPLACEMENT DATA
# ============================================================

before_replacement["DATETIME"] = (
    pd.to_datetime(
