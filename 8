print(
    f"Total ESNs in replacement data : "
    f"{replacement_counts['ESN'].nunique():,}"
)

print(
    f"ESNs with exactly ONE replacement : "
    f"{len(single_replacement_esns):,}"
)


# Keep ONLY single-replacement ESNs

replacement_single = replacement_valid[
    replacement_valid["ESN"].isin(
