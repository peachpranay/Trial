)


# ============================================================
# 13. MERGE REPLACEMENT DATE WITH TAKEOFF DATA
# ============================================================

df_merged = df.merge(

    replacement_single,

    on="ESN",

    how="inner"

)


print("\n")
print("=" * 70)
print("AFTER REPLACEMENT-DATA MATCHING")
print("=" * 70)

print(
    f"Rows : {len(df_merged):,}"
)

print(
    f"ESNs : {df_merged['ESN'].nunique():,}"
)


# ============================================================
# 14. CREATE DATE FOR COMPARISON
# ============================================================

df_merged["DATE_ONLY"] = (

    pd.to_datetime(
        df_merged["DATETIME"]
    )

    .dt.date

)


# ============================================================
# 15. SPLIT DATA INTO BEFORE / AFTER REPLACEMENT
# ============================================================
#
# IMPORTANT:
#
# This happens BEFORE Mahalanobis analysis.
#
# Mahalanobis will ONLY use before_replacement.
# ============================================================

before_replacement = df_merged[
    df_merged["DATE_ONLY"]
    <=
    df_merged[
        REPLACEMENT_DATE_COLUMN
    ]
].copy()


after_replacement = df_merged[
    df_merged["DATE_ONLY"]
    >
    df_merged[
        REPLACEMENT_DATE_COLUMN
    ]
].copy()


print("\n")
print("=" * 70)
print("BEFORE / AFTER REPLACEMENT SPLIT")
print("=" * 70)

