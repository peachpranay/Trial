    f"BEFORE replacement rows : "
    f"{len(before_replacement):,}"
)

print(
    f"AFTER replacement rows  : "
    f"{len(after_replacement):,}"
)

print(
    f"BEFORE replacement ESNs : "
    f"{before_replacement['ESN'].nunique():,}"
)

print(
    f"AFTER replacement ESNs  : "
    f"{after_replacement['ESN'].nunique():,}"
)


# ============================================================
# 16. FIND ESNs WITH NO PREVIOUS SHOP VISIT
# ============================================================
#
# IMPORTANT:
#
# This calculation is performed on BEFORE-REPLACEMENT DATA.
#
# Only ESNs satisfying:
#
#       max(Run_Number) == 1
#
