    if len(df_esn) < 10:
        continue

    # --------------------------------------------------------
    # HEALTHY BASELINE: 20% - 60% LIFE
    # --------------------------------------------------------

    baseline_mask = (
        (df_esn["LIFE_PERCENT"] >= BASELINE_START)
        &
        (df_esn["LIFE_PERCENT"] <= BASELINE_END)
    )

    baseline_count = baseline_mask.sum()

    if baseline_count < 5:
        print(
            f"Skipping ESN {int(esn)}: "
            f"only {baseline_count} baseline points"
        )
        continue

    # --------------------------------------------------------
    # MAHALANOBIS
    # --------------------------------------------------------

    df_esn["MAHALANOBIS_SCORE"] = (
        compute_mahalanobis_scores(
            df_esn,
            baseline_mask,
            ema_columns
        )
    )

    # --------------------------------------------------------
    # ROLLING SCORE
    # --------------------------------------------------------

    df_esn["ROLLING_SCORE"] = (
        df_esn[
            "MAHALANOBIS_SCORE"
        ]
        .rolling(
            window=ROLLING_WINDOW,
            min_periods=1
        )
        .mean()
    )

    # --------------------------------------------------------
    # Z-SCORE OF MAHALANOBIS
    # --------------------------------------------------------

    score_mean = (
        df_esn["MAHALANOBIS_SCORE"]
        .mean()
    )

    score_std = (
        df_esn["MAHALANOBIS_SCORE"]
        .std()
    )

    if pd.isna(score_std) or score_std == 0:
        score_std = 1.0

    df_esn["MAHALANOBIS_SCORE_STD"] = (
        df_esn["MAHALANOBIS_SCORE"]
        - score_mean
    ) / score_std

    # --------------------------------------------------------
    # Z-SCORE OF ROLLING SCORE
    # --------------------------------------------------------

    rolling_mean_global = (
        df_esn["ROLLING_SCORE"]
        .mean()
    )

    rolling_std_global = (
        df_esn["ROLLING_SCORE"]
        .std()
    )

    if (
        pd.isna(rolling_std_global)
        or rolling_std_global == 0
    ):
        rolling_std_global = 1.0

    df_esn["ROLLING_SCORE_STD"] = (
        df_esn["ROLLING_SCORE"]
        - rolling_mean_global
    ) / rolling_std_global

    # --------------------------------------------------------
    # EXISTING SPIKE FILTER
    # --------------------------------------------------------

    rolling_local_mean = (
        df_esn["MAHALANOBIS_SCORE"]
        .rolling(
            window=ROLLING_WINDOW,
            min_periods=1
        )
        .mean()
    )

    rolling_local_std = (
        df_esn["MAHALANOBIS_SCORE"]
        .rolling(
            window=ROLLING_WINDOW,
            min_periods=1
        )
        .std()
        .fillna(0)
    )

    spike_limit = (
        rolling_local_mean
        +
        SPIKE_THRESHOLD *
        rolling_local_std
    )

    df_esn["IS_SPIKE"] = (
        df_esn["MAHALANOBIS_SCORE"]
        > spike_limit
    )

    # Keep the original score and create cleaned score
    df_esn["MAHALANOBIS_SCORE_CLEAN"] = (
        df_esn["MAHALANOBIS_SCORE"]
        .where(
            ~df_esn["IS_SPIKE"],
            np.nan
        )
    )

    # Recalculate rolling score after spike removal
    df_esn["ROLLING_SCORE_CLEAN"] = (
        df_esn["MAHALANOBIS_SCORE_CLEAN"]
        .rolling(
            window=ROLLING_WINDOW,
            min_periods=1
        )
        .mean()
    )

    # --------------------------------------------------------
    # 95TH PERCENTILE
    #
    # Same presentation logic:
    # ignore first 20% of life
    # --------------------------------------------------------

    percentile_data = df_esn[
        df_esn["LIFE_PERCENT"] >= PLOT_START_LIFE
    ]["ROLLING_SCORE_CLEAN"].dropna()

    if len(percentile_data) > 0:

        percentile_95 = np.percentile(
            percentile_data,
            PERCENTILE
        )

    else:

        percentile_95 = np.nan

    df_esn["PERCENTILE_95"] = percentile_95

    # --------------------------------------------------------
    # THRESHOLD CROSSING
    # --------------------------------------------------------

    if not np.isnan(percentile_95):

        df_esn["ABOVE_95TH"] = (
            df_esn["ROLLING_SCORE_CLEAN"]
            > percentile_95
        )

    else:

        df_esn["ABOVE_95TH"] = False

    # --------------------------------------------------------
    # DETECTION START
    # --------------------------------------------------------

    detection_rows = df_esn[
        (
            df_esn["ABOVE_95TH"]
        )
        &
        (
            df_esn["LIFE_PERCENT"]
            >= PLOT_START_LIFE
        )
    ]

    if len(detection_rows) > 0:

        detection_life = (
            detection_rows[
                "LIFE_PERCENT"
            ].iloc[0]
        )

    else:

        detection_life = np.nan

    # --------------------------------------------------------
    # REPLACEMENT DATE
    # --------------------------------------------------------

    replacement_date = (
        df_esn["Confirmed Replacement Date"]
        .iloc[0]
    )

    # --------------------------------------------------------
    # SUMMARY
    # --------------------------------------------------------

    summary_results.append({

        "ESN": int(esn),

        "Observations":
            len(df_esn),

        "Baseline_Observations":
            baseline_count,

        "Baseline_Start_%":
            BASELINE_START,

        "Baseline_End_%":
            BASELINE_END,

        "95th_Percentile":
            percentile_95,

        "Detection_Life_%":
            detection_life,

        "Maximum_Mahalanobis":
            df_esn[
                "MAHALANOBIS_SCORE"
            ].max(),

        "Maximum_Rolling":
            df_esn[
                "ROLLING_SCORE_CLEAN"
            ].max(),

        "Replacement_Date":
            replacement_date
    })

    all_results.append(
        df_esn
    )


