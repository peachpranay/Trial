def create_esn_plot(
    esn,
    data,
    output_directory
):

    df_plot = (
        data[
            data["ESN"] == esn
        ]
        .copy()
        .sort_values("LIFE_PERCENT")
    )

    if df_plot.empty:
        return None

    # --------------------------------------------------------
    # Remove first 20% from presentation
    # --------------------------------------------------------

    df_plot = df_plot[
        df_plot["LIFE_PERCENT"]
        >= PLOT_START_LIFE
    ].copy()

    if df_plot.empty:
        return None

    threshold = (
        df_plot["PERCENTILE_95"]
        .dropna()
        .iloc[0]
        if df_plot["PERCENTILE_95"]
        .notna()
        .any()
        else np.nan
    )

    replacement_date = (
        df_plot["Confirmed Replacement Date"]
        .iloc[0]
    )

    # --------------------------------------------------------
    # Figure
    # --------------------------------------------------------

    fig, ax = plt.subplots(
        figsize=(13, 6.5)
    )

    # Healthy baseline
    ax.axvspan(
        BASELINE_START,
        BASELINE_END,
        alpha=0.10,
        label="Healthy baseline (20–60%)"
    )

    # Raw Mahalanobis
    ax.plot(
        df_plot["LIFE_PERCENT"],
        df_plot["MAHALANOBIS_SCORE"],
        linewidth=1.2,
        alpha=0.45,
        label="Mahalanobis score"
    )

    # Rolling score
    ax.plot(
        df_plot["LIFE_PERCENT"],
        df_plot["ROLLING_SCORE_CLEAN"],
        linewidth=2.5,
        label="Rolling score (5)"
    )

    # 95th percentile
    if not np.isnan(threshold):

        ax.axhline(
            threshold,
            linestyle="--",
            linewidth=2,
            label=f"95th percentile = {threshold:.2f}"
        )

    # --------------------------------------------------------
    # Detection region
    # --------------------------------------------------------

    detected = df_plot[
        df_plot["ABOVE_95TH"]
    ]

    if not detected.empty:

        detection_start = (
            detected["LIFE_PERCENT"]
            .min()
        )

        ax.axvline(
            detection_start,
            linestyle=":",
            linewidth=2,
            label=(
                f"Threshold crossing "
                f"≈ {detection_start:.1f}% life"
            )
        )

    # --------------------------------------------------------
    # Replacement marker
    # --------------------------------------------------------

    # We don't force a life percentage for replacement.
    # Instead annotate it in the title/subtitle.

    # --------------------------------------------------------
    # Labels
    # --------------------------------------------------------

    ax.set_title(
        f"Breather Degradation Trajectory — ESN {int(esn)}",
        fontweight="bold",
        pad=15
    )

    ax.set_xlabel(
        "Engine Life (%)"
    )

    ax.set_ylabel(
        "Mahalanobis Distance"
    )

    ax.set_xlim(
        PLOT_START_LIFE,
        100
    )

    ax.grid(
        True,
        alpha=0.20
    )

    ax.legend(
        loc="upper left",
        frameon=True
    )

    # --------------------------------------------------------
    # Subtitle
    # --------------------------------------------------------

    ax.text(
        0.99,
        0.96,
        f"Replacement: {replacement_date}",
        transform=ax.transAxes,
        ha="right",
        va="top",
        fontsize=10
    )

    plt.tight_layout()

    # --------------------------------------------------------
    # Save
    # --------------------------------------------------------

    output_path = os.path.join(
        output_directory,
        f"ESN_{int(esn)}_Mahalanobis.png"
    )

    plt.savefig(
        output_path,
        bbox_inches="tight"
    )

    plt.show()
    plt.close()

    return output_path


