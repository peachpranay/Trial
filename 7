# 14. NORMALIZE ENGINE LIFE
# ============================================================

def normalize_life_score(data):

    data = (
        data
        .sort_values(["ESN", "DATETIME"])
        .copy()
    )

    # Same logic as your existing method:
    # sequential row number for each ESN

    data["ROW_NUM"] = (
        data
        .groupby("ESN")
        .cumcount()
    )

    # Maximum row number for each ESN
    max_row = (
        data
        .groupby("ESN")["ROW_NUM"]
        .transform("max")
    )

    # Avoid division by zero
    max_row = max_row.replace(0, np.nan)

    data["LIFE_PERCENT"] = (
        data["ROW_NUM"] /
        max_row *
        100
    )

    data["LIFE_PERCENT"] = (
        data["LIFE_PERCENT"]
        .fillna(0)
    )

    return data


