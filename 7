# ============================================================
# 15. MAHALANOBIS FUNCTION
# ============================================================

def compute_mahalanobis_scores(
    data,
    baseline_mask,
    feature_columns
):

    baseline = data.loc[
        baseline_mask,
        feature_columns
    ].dropna()

    if len(baseline) < 5:
        raise ValueError(
            "Not enough baseline observations "
            "to calculate Mahalanobis distance."
        )

    X_baseline = baseline.values.astype(float)

    # Healthy baseline mean
    mean_base = np.mean(
        X_baseline,
        axis=0
    )

    # Healthy baseline covariance
    cov_base = np.cov(
        X_baseline,
        rowvar=False
    )

    # Numerical stability
    cov_base = np.atleast_2d(cov_base)

    # Small regularization
    regularization = (
        np.eye(cov_base.shape[0])
        * 1e-8
    )

    cov_base = (
        cov_base +
        regularization
    )

    cov_inv = np.linalg.pinv(
        cov_base
    )

    # Calculate score for every row
    scores = []

    for _, row in data.iterrows():

        x = row[
            feature_columns
        ].values.astype(float)

        if np.isnan(x).any():
            scores.append(np.nan)
            continue

        diff = x - mean_base

        score = np.sqrt(
            diff.T @
            cov_inv @
            diff
        )

        scores.append(score)

    return np.array(scores)


