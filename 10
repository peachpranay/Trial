# ============================================================
# 21. MAHALANOBIS FUNCTION
# ============================================================

def compute_mahalanobis_scores(
    data,
    baseline_mask,
    feature_columns
):

    baseline = (

        data.loc[
            baseline_mask,
            feature_columns
        ]

        .dropna()

    )


    if len(baseline) < 10:

        raise ValueError(
            "Not enough healthy baseline "
            "observations."
        )


    X_baseline = (
        baseline
        .values
        .astype(float)
    )


    # --------------------------------------------------------
    # Healthy mean
    # --------------------------------------------------------

    mean_base = np.mean(
        X_baseline,
        axis=0
    )


    # --------------------------------------------------------
    # Healthy covariance
    # --------------------------------------------------------

    cov_base = np.cov(
        X_baseline,
        rowvar=False
    )


    cov_base = np.atleast_2d(
        cov_base
    )


    # --------------------------------------------------------
    # Numerical stabilization
    # --------------------------------------------------------

    cov_base = (

        cov_base

        +

        np.eye(
            cov_base.shape[0]
        )

        *

        1e-8

    )


    # --------------------------------------------------------
    # Pseudo-inverse
    # --------------------------------------------------------

    cov_inv = np.linalg.pinv(
        cov_base
    )


    # --------------------------------------------------------
    # Mahalanobis distance
    # --------------------------------------------------------

    scores = []


    for _, row in data.iterrows():

        x = (

            row[
                feature_columns
            ]

            .values

            .astype(float)

        )


        if np.isnan(x).any():

            scores.append(
                np.nan
            )

            continue


        difference = (
            x - mean_base
        )


        score = np.sqrt(

            difference.T

            @

            cov_inv

            @

            difference

        )


        scores.append(
            score
        )


    return np.array(
        scores
    )


# ============================================================
# 22. PERSISTENCE FUNCTION
# ============================================================

def calculate_persistence(
    above_threshold,
    required_points
):

    values = (
        above_threshold
        .fillna(False)
        .astype(bool)
        .to_numpy()
    )


    persistence_count = np.zeros(
        len(values),
        dtype=int
    )


    current_count = 0


    for i, value in enumerate(values):

        if value:

            current_count += 1

        else:

            current_count = 0


        persistence_count[i] = (
            current_count
        )


    sustained = (

        persistence_count

        >=

        required_points

    )


    # --------------------------------------------------------
    # Start of every persistent sequence
    # --------------------------------------------------------

    sustained_start = np.zeros(
        len(values),
        dtype=bool
    )


    for i in range(len(values)):

        if not sustained[i]:

            continue


        if i == 0:

            sustained_start[i] = True

        elif not sustained[i - 1]:

            sustained_start[i] = True


    return (

        persistence_count,

        sustained,

        sustained_start

    )


