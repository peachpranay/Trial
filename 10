def normalize_life_score(data):

    data = (

        data

        .sort_values(
            [
                "ESN",
                "DATETIME"
            ]
        )

        .copy()

    )


    data["ROW_NUM"] = (

        data

        .groupby("ESN")

        .cumcount()

    )


    max_row = (

        data

        .groupby("ESN")[
            "ROW_NUM"
        ]

        .transform("max")

    )


    max_row = max_row.replace(
        0,
        np.nan
    )


    data["LIFE_PERCENT"] = (

        data["ROW_NUM"]

        /

        max_row

        *

        100

    )


    data["LIFE_PERCENT"] = (

        data["LIFE_PERCENT"]

        .fillna(0)

    )


    return data


