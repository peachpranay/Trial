# ============================================================
# 36. ESN PLOT FUNCTION
# ============================================================

def create_esn_plot(
    esn,
    data,
    summary,
    output_directory
):


    plot_data = (

        data[
            data[
                "ESN"
            ] == esn
        ]

        .copy()

        .sort_values(
            "LIFE_PERCENT"
        )

    )


    plot_data = plot_data[
        plot_data[
            "LIFE_PERCENT"
        ]
        >= PLOT_START_LIFE
    ].copy()


    if plot_data.empty:

        return None


    # --------------------------------------------------------
    # Summary row
    # --------------------------------------------------------

    row = (

        summary[
            summary[
                "ESN"
            ] == esn
        ]

        .iloc[0]

    )


    threshold = row[
        "Degradation_Threshold"
    ]


    healthy_p95 = row[
        "Healthy_P95"
    ]


    detection_life = row[
        "First_Sustained_Detection_Life_%"
    ]


    # ========================================================
    # FIGURE
    # ========================================================

    fig, ax = plt.subplots(

        figsize=(13, 6.5)

    )


    # ========================================================
    # HEALTHY BASELINE
    # ========================================================

    ax.axvspan(

        BASELINE_START,

        BASELINE_END,

        alpha=0.10,

        label="Healthy baseline (20–60%)"

    )


    # ========================================================
    # RAW MAHALANOBIS
    # ========================================================

    ax.plot(

        plot_data[
            "LIFE_PERCENT"
        ],

        plot_data[
            "MAHALANOBIS_SCORE"
        ],

        linewidth=1.0,

        alpha=0.25,

        label="Raw Mahalanobis"

    )


    # ========================================================
    # CLEAN ROLLING SCORE
    # ========================================================

    ax.plot(

        plot_data[
            "LIFE_PERCENT"
        ],

        plot_data[
            "ROLLING_SCORE_CLEAN"
        ],

        linewidth=2.8,

        label="Rolling Mahalanobis (5)"

    )


    # ========================================================
    # HEALTHY P95
    # ========================================================

    ax.axhline(

        healthy_p95,

        linestyle=":",

        linewidth=1.5,

        alpha=0.7,

        label=(

            f"Healthy P95 = "
            f"{healthy_p95:.2f}"

        )

    )


    # ========================================================
    # MULTIPLIED DEGRADATION THRESHOLD
    # ========================================================

    ax.axhline(

        threshold,

        linestyle="--",

        linewidth=2.2,

        label=(

            f"Threshold = "
            f"{THRESHOLD_MULTIPLIER:.2f}× P95 "
            f"= {threshold:.2f}"

        )

    )


    # ========================================================
    # 100% REPLACEMENT MARKER
    # ========================================================

    ax.axvline(

        100,

        color="black",

        linewidth=4,

        linestyle="-",

        label="Breather replacement"

    )


    # ========================================================
    # SUSTAINED CROSSING MARKERS
    # ========================================================

    crossing_starts = plot_data[
        plot_data[
            "SUSTAINED_CROSSING_START"
        ]
    ]


    if not crossing_starts.empty:

        crossing_lives = (

            crossing_starts[
                "LIFE_PERCENT"
            ]

            .tolist()

        )


        # ----------------------------------------------------
        # First sustained period
        # ----------------------------------------------------

        first_crossing_start = (
            crossing_lives[0]
        )


        first_detection_row = (

            plot_data[
                plot_data[
                    "SUSTAINED_DEGRADATION"
                ]
            ]

            .iloc[0]

        )


        first_detection = (

            first_detection_row[
                "LIFE_PERCENT"
            ]

        )


        # ----------------------------------------------------
        # Shade first persistence window
        # ----------------------------------------------------

        ax.axvspan(

            first_crossing_start,

            first_detection,

            alpha=0.15,

            label="First 5-point persistence"

        )


        # ----------------------------------------------------
        # First confirmed detection
        # ----------------------------------------------------

        ax.axvline(

            first_detection,

            linestyle=":",

            linewidth=2.8,

            label=(

                f"First sustained detection "
                f"≈ {first_detection:.1f}%"

            )

        )


        # ----------------------------------------------------
        # Subsequent crossings
        # ----------------------------------------------------

        if len(crossing_lives) > 1:

            for i, life in enumerate(
                crossing_lives[1:]
            ):

                ax.axvline(

                    life,

                    linestyle=":",

                    linewidth=1.8,

                    alpha=0.75,

                    label=(

                        "Subsequent sustained "
                        "crossing"
                        if i == 0
                        else None

                    )

                )


    # ========================================================
    # AXES
    # ========================================================

    ax.set_xlim(

        PLOT_START_LIFE,

        100

    )


    ax.set_xlabel(
        "Engine life (%)"
    )


    ax.set_ylabel(
        "Mahalanobis distance"
    )


    ax.set_title(

        f"Breather Degradation Trajectory — "
        f"ESN {int(esn)}",

        fontweight="bold",

        pad=15

    )


    ax.grid(
        True,
        alpha=0.20
    )


    # ========================================================
    # INFORMATION BOX
    # ========================================================

    if pd.isna(
        detection_life
    ):

        detection_text = (
            "No sustained detection"
        )

    else:

        detection_text = (

            f"First sustained detection: "
            f"{detection_life:.1f}% life"

        )


    info_text = (

        f"Healthy P95: "
        f"{healthy_p95:.2f}\n"

        f"Multiplier: "
        f"{THRESHOLD_MULTIPLIER:.2f}×\n"

        f"Threshold: "
        f"{threshold:.2f}\n"

        f"{detection_text}\n"

        f"Warning lead: "
        f"{row['Warning_Lead_%']:.1f}%"

        if not pd.isna(
            row["Warning_Lead_%"]
        )

        else

        f"Healthy P95: "
        f"{healthy_p95:.2f}\n"

        f"Multiplier: "
        f"{THRESHOLD_MULTIPLIER:.2f}×\n"

        f"Threshold: "
        f"{threshold:.2f}\n"

        f"{detection_text}\n"

        f"Warning lead: N/A"

    )


    ax.text(

        0.98,

        0.97,

        info_text,

        transform=ax.transAxes,

        ha="right",

        va="top",

        fontsize=10,

        bbox=dict(

            boxstyle="round,pad=0.4",

            alpha=0.12

        )

    )


    ax.legend(
        loc="upper left"
    )


    plt.tight_layout()


    # ========================================================
    # SAVE
    # ========================================================

    output_path = os.path.join(

        output_directory,

        f"ESN_{int(esn)}_Mahalanobis_Demo.png"

    )


    plt.savefig(

        output_path,

        bbox_inches="tight"

    )


    plt.show()

    plt.close()


    return output_path


