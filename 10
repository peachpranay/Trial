    f"{len(analysis_esns):,}"
)


# ============================================================
# 24. ESN LOOP
# ============================================================

for esn in analysis_esns:


    # --------------------------------------------------------
    # Get this ESN only
    # --------------------------------------------------------

    df_esn = (

        before_replacement[

            before_replacement[
                "ESN"
            ] == esn

        ]

        .copy()

        .sort_values(
            "DATETIME"
        )

        .reset_index(
            drop=True
        )

    )


    # Need enough observations

    if len(df_esn) < 20:

        continue


    # --------------------------------------------------------
    # HEALTHY BASELINE
    # 20-60%
    # --------------------------------------------------------

    baseline_mask = (

        (

            df_esn[
                "LIFE_PERCENT"
            ]

            >=

            BASELINE_START

        )

        &

        (

            df_esn[
                "LIFE_PERCENT"
            ]

            <=

            BASELINE_END

        )

    )


    baseline_count = (
        baseline_mask.sum()
    )


    if baseline_count < 10:

        continue


    # --------------------------------------------------------
    # MAHALANOBIS
    # --------------------------------------------------------

    df_esn[
        "MAHALANOBIS_SCORE"
    ] = (

        compute_mahalanobis_scores(

            df_esn,

            baseline_mask,

            ema_columns

        )

    )


    # --------------------------------------------------------
    # ROLLING MAHALANOBIS
    # --------------------------------------------------------

    df_esn[
        "ROLLING_SCORE"
    ] = (

        df_esn[
            "MAHALANOBIS_SCORE"
        ]

        .rolling(

            window=ROLLING_WINDOW,

            min_periods=1

        )

        .mean()

    )


    # ========================================================
    # ISOLATED SPIKE FILTER
    # ========================================================

    local_mean = (

        df_esn[
            "MAHALANOBIS_SCORE"
        ]

        .rolling(

            window=ROLLING_WINDOW,

            min_periods=1

        )

        .mean()

    )


    local_std = (

        df_esn[
            "MAHALANOBIS_SCORE"
        ]

        .rolling(

            window=ROLLING_WINDOW,

            min_periods=1

        )

        .std()

        .fillna(0)

    )


    spike_limit = (

        local_mean

        +

        SPIKE_THRESHOLD

        *

        local_std

    )


    df_esn[
        "IS_SPIKE"
    ] = (

        df_esn[
            "MAHALANOBIS_SCORE"
        ]

        >

        spike_limit

    )


    # --------------------------------------------------------
    # CLEAN MAHALANOBIS
    # --------------------------------------------------------

    df_esn[
        "MAHALANOBIS_SCORE_CLEAN"
    ] = (

        df_esn[
            "MAHALANOBIS_SCORE"
        ]

        .where(
            ~df_esn[
                "IS_SPIKE"
            ]
        )

    )


    # --------------------------------------------------------
    # CLEAN ROLLING SCORE
    # --------------------------------------------------------

    df_esn[
        "ROLLING_SCORE_CLEAN"
    ] = (

        df_esn[
            "MAHALANOBIS_SCORE_CLEAN"
        ]

        .rolling(

            window=ROLLING_WINDOW,

            min_periods=1

        )

        .mean()

    )


    # ========================================================
    # HEALTHY 95TH PERCENTILE
    # ========================================================
    #
    # IMPORTANT:
    #
    # The P95 is calculated ONLY from healthy 20-60% data.
    #
    # Late-life degradation does NOT influence the baseline
    # threshold.
    # ========================================================

    healthy_rolling = (

        df_esn.loc[
            baseline_mask,
            "ROLLING_SCORE_CLEAN"
        ]

        .dropna()

    )


    if len(healthy_rolling) < 10:

        continue


    healthy_p95 = np.percentile(

        healthy_rolling,

        PERCENTILE

    )


    # ========================================================
    # MULTIPLIED THRESHOLD
    # ========================================================
    #
    # Threshold =
    #
    # Healthy P95 × multiplier
    #
    # Example:
    #
    # Healthy P95 = 4
    # Multiplier = 1.5
    #
    # Threshold = 6
    # ========================================================

    threshold = (

        healthy_p95

        *

        THRESHOLD_MULTIPLIER

    )


    df_esn[
        "HEALTHY_P95"
    ] = healthy_p95


    df_esn[
        "THRESHOLD_MULTIPLIER"
    ] = THRESHOLD_MULTIPLIER


    df_esn[
        "DEGRADATION_THRESHOLD"
    ] = threshold


    # ========================================================
    # ABOVE THRESHOLD
    # ========================================================

    df_esn[
        "ABOVE_THRESHOLD"
    ] = (

        (

            df_esn[
                "ROLLING_SCORE_CLEAN"
            ]

            >

            threshold

        )

        &

        (

            df_esn[
                "LIFE_PERCENT"
            ]

            >=

            PLOT_START_LIFE

        )

    )


    # ========================================================
    # PERSISTENCE
    # ========================================================

    (
        persistence_count,

        sustained,

        sustained_start

    ) = calculate_persistence(

        df_esn[
            "ABOVE_THRESHOLD"
        ],

        SUSTAINED_POINTS

    )


    df_esn[
        "PERSISTENCE_COUNT"
    ] = persistence_count


    df_esn[
        "SUSTAINED_DEGRADATION"
    ] = sustained


    df_esn[
        "SUSTAINED_CROSSING_START"
    ] = sustained_start


    # ========================================================
    # FIRST CONFIRMED SUSTAINED DETECTION
    # ========================================================
    #
    # Example:
    #
    # Above threshold:
    #
    # False True True True True True
    #
    # Persistence:
    #
    # 0     1    2    3    4    5
    #
    # The detection is CONFIRMED at persistence = 5.
    # ========================================================

    detection_rows = df_esn[
        df_esn[
            "SUSTAINED_DEGRADATION"
        ]
    ]


    if not detection_rows.empty:

        first_detection_position = (

            detection_rows.index[0]

        )


        first_detection_row = (

            df_esn.loc[
                first_detection_position
            ]

        )


        first_detection_life = (

            first_detection_row[
                "LIFE_PERCENT"
            ]

        )


        first_detection_datetime = (

            first_detection_row[
                "DATETIME"
            ]

        )


        # Start of the 5-point persistent run

        first_run_start_position = (

            first_detection_position

            -

            SUSTAINED_POINTS

            +

            1

        )


        if first_run_start_position >= 0:

            first_run_start_row = (

                df_esn.iloc[
                    first_run_start_position
                ]

            )


            first_crossing_start_life = (

                first_run_start_row[
                    "LIFE_PERCENT"
                ]

            )

        else:

            first_crossing_start_life = np.nan


    else:

        first_detection_life = np.nan

        first_detection_datetime = pd.NaT

        first_crossing_start_life = np.nan


    # ========================================================
    # SUBSEQUENT SUSTAINED CROSSINGS
    # ========================================================

    crossing_start_rows = df_esn[
        df_esn[
            "SUSTAINED_CROSSING_START"
        ]
    ]


    subsequent_crossing_lives = []


    first_crossing_already_found = False


    for idx in crossing_start_rows.index:

        current_life = (

            df_esn.loc[
                idx,
                "LIFE_PERCENT"
            ]

        )


        if not first_crossing_already_found:

            first_crossing_already_found = True

            continue


        subsequent_crossing_lives.append(
            current_life
        )


    if len(subsequent_crossing_lives) > 0:

        subsequent_crossings_text = (

            ", ".join(

                [

                    f"{x:.1f}%"

                    for x
                    in subsequent_crossing_lives

                ]

            )

        )

    else:

        subsequent_crossings_text = ""


    # ========================================================
    # NUMBER OF SUSTAINED PERIODS
    # ========================================================

    number_of_sustained_periods = (

        int(
            crossing_start_rows.shape[0]
        )

    )


    # ========================================================
    # LATE-LIFE STATISTICS
    # ========================================================

    late_data = df_esn[
        df_esn[
            "LIFE_PERCENT"
        ]
        >= 80
    ]


    if not late_data.empty:

        late_mean = (

            late_data[
                "ROLLING_SCORE_CLEAN"
            ]

            .mean()

        )


        late_median = (

            late_data[
                "ROLLING_SCORE_CLEAN"
            ]

            .median()

        )

    else:

        late_mean = np.nan

        late_median = np.nan


    # ========================================================
    # HEALTHY BASELINE STATISTICS
    # ========================================================

    healthy_mean = (
        healthy_rolling.mean()
    )


    healthy_median = (
        healthy_rolling.median()
    )


    # ========================================================
    # LATE / HEALTHY RATIO
    # ========================================================

    if (

        not pd.isna(
            healthy_mean
        )

        and

        healthy_mean > 0

    ):

        late_to_healthy_ratio = (

            late_mean

            /

            healthy_mean

        )

    else:

        late_to_healthy_ratio = np.nan


    # ========================================================
    # MAXIMUM SCORE
    # ========================================================

    maximum_score = (

        df_esn[
            "MAHALANOBIS_SCORE"
        ]

        .max()

    )


    maximum_clean_score = (

        df_esn[
            "ROLLING_SCORE_CLEAN"
        ]

        .max()

    )


    # ========================================================
    # WARNING LEAD
    # ========================================================
    #
    # Replacement = 100%
    #
    # Warning lead =
    #
    # 100 - detection life
    # ========================================================

    if not pd.isna(
        first_detection_life
    ):

        warning_lead = (

            100

            -

            first_detection_life

        )

    else:

        warning_lead = np.nan


    # ========================================================
    # REPLACEMENT DATE
    # ========================================================

    replacement_date = (

        df_esn[
            REPLACEMENT_DATE_COLUMN
        ]

        .iloc[0]

    )


    # ========================================================
    # SUMMARY ROW
    # ========================================================

    summary_results.append({

        "ESN":
            int(esn),

        "Observations":
            len(df_esn),

        "Baseline_Observations":
            baseline_count,

        "Healthy_Mean":
            healthy_mean,

        "Healthy_Median":
            healthy_median,

        "Healthy_P95":
            healthy_p95,

        "Threshold_Multiplier":
            THRESHOLD_MULTIPLIER,

        "Degradation_Threshold":
            threshold,

        "First_Crossing_Start_Life_%":
            first_crossing_start_life,

        "First_Sustained_Detection_Life_%":
            first_detection_life,

        "Warning_Lead_%":
            warning_lead,

        "First_Sustained_Detection_Date":
            first_detection_datetime,

        "Subsequent_Crossings":
            subsequent_crossings_text,

        "Number_Sustained_Periods":
            number_of_sustained_periods,

        "Late_Life_Mean":
            late_mean,

        "Late_Life_Median":
            late_median,

        "Late_to_Healthy_Ratio":
            late_to_healthy_ratio,

        "Maximum_Raw_Mahalanobis":
            maximum_score,

        "Maximum_Clean_Rolling":
            maximum_clean_score,

        "Sustained_Detection":
            not detection_rows.empty,

        "Replacement_Date":
            replacement_date

    })


    # Store complete ESN result

    all_results.append(
